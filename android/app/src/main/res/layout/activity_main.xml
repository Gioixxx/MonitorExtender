<?xml version="1.0" encoding="utf-8"?>
<!--
    Selettore di ingresso, come il menu di un monitor: due sorgenti, ciascuna con il proprio
    stato e con quello che sa fare. La larghezza del contenuto viene limitata da MainActivity,
    altrimenti su un tablet in orizzontale le righe si stirerebbero per oltre mille dp.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bezel"
    android:fillViewport="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="40dp"
            android:paddingEnd="24dp"
            android:paddingBottom="40dp">

            <TextView
                style="@style/Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/ink_faint"
                android:textSize="12sp" />

            <TextView
                style="@style/Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:letterSpacing="0.02"
                android:text="@string/screen_title"
                android:textAllCaps="false"
                android:textSize="28sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:background="@color/rule" />

            <!-- Ingresso 1: cavo -->
            <LinearLayout
                android:id="@+id/usb_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/input_unavailable"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/usb_title"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/usb_state"
                        style="@style/Readout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/checking"
                        android:textAllCaps="true"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/usb_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/ink_dim"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/usb_command"
                    style="@style/Readout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/code_block"
                    android:padding="12dp"
                    android:text="@string/usb_command"
                    android:textColor="@color/ink"
                    android:textIsSelectable="true"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <TextView
                    style="@style/Readout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/usb_caps"
                    android:textAllCaps="true"
                    android:textColor="@color/ink_faint"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Ingresso 2: rete -->
            <LinearLayout
                android:id="@+id/wifi_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/input_unavailable"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/wifi_title"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/wifi_state"
                        style="@style/Readout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/checking"
                        android:textAllCaps="true"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/wifi_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/ink_dim"
                    android:textSize="14sp" />

                <TextView
                    style="@style/Readout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/wifi_caps"
                    android:textAllCaps="true"
                    android:textColor="@color/ink_faint"
                    android:textSize="11sp" />
            </LinearLayout>

            <Button
                android:id="@+id/recheck"
                style="@style/QuietButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/recheck" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="36dp"
                android:background="@color/rule" />

            <TextView
                style="@style/Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/manual_label"
                android:textColor="@color/ink_faint"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/address"
                style="@style/Readout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:autofillHints="no"
                android:hint="@string/address_hint"
                android:imeOptions="actionDone"
                android:inputType="textUri"
                android:maxLines="1"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/connect_native"
                    style="@style/QuietButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/connect_native" />

                <Button
                    android:id="@+id/connect_web_view"
                    style="@style/QuietButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/connect_web_view" />
            </LinearLayout>

        </LinearLayout>
    </FrameLayout>
</ScrollView>
