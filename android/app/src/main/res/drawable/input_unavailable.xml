<?xml version="1.0" encoding="utf-8"?>
<!-- Stesso riquadro con la barra spenta: nessun colore saturo se il link non c'e'. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/panel" />
            <stroke android:width="1dp" android:color="@color/rule" />
        </shape>
    </item>
    <item android:width="4dp" android:gravity="left|fill_vertical">
        <shape android:shape="rectangle">
            <solid android:color="@color/rule" />
        </shape>
    </item>
</layer-list>
