<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      WinExe e non Exe: avviandosi al login non deve comparire una finestra nera. Quando serve
      un terminale (opzioni "console" e "probe") il programma si riaggancia a quello del
      chiamante con AttachConsole.
    -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MonitorExtender.Server</RootNamespace>
    <AssemblyName>MonitorExtender.Server</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Serve solo per la copia riga per riga dei pixel dalla texture DXGI. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- La consapevolezza DPI la imposta ScreenCapturer a runtime, prima della cattura. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Generata da tools\build-icon.ps1: stesso monitor stilizzato dell'icona di stato. -->
    <ApplicationIcon>icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Interop DXGI/Direct3D per la Desktop Duplication API. A mano sarebbero centinaia di
      righe di dichiarazioni COM: qui serve a misurare se la cattura via GPU conviene
      rispetto a CopyFromScreen, e sbagliare l'interop falserebbe proprio la misura.
    -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
  </ItemGroup>

</Project>
